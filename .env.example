# Copy to apps/web/.env.local for local; set the same keys in Vercel Project → Settings → Environment Variables.

# ── Required (web / Next.js on Vercel) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=STT Platform

# ── Optional email (Resend) ────────────────────────────────────
# Without these, in-app /alerts still work; invites show share link.
RESEND_API_KEY=
EMAIL_FROM=STT Platform <onboarding@resend.dev>

# ── Nest API only (if you deploy apps/api separately — not needed for web-only) ──
SUPABASE_SERVICE_ROLE_KEY=
API_URL=
API_SECRET_KEY=

# Do NOT expose SERVICE_ROLE or API_SECRET_KEY as NEXT_PUBLIC_*.
# After first Vercel deploy, set NEXT_PUBLIC_APP_URL to the real production URL
# (and add that URL in Supabase Auth → URL configuration → Site URL / Redirect URLs).
